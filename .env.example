# Supabase (Project Settings → API Keys)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Claude (console.anthropic.com → API Keys, format sk-ant-api03-…)
ANTHROPIC_API_KEY=

# Microsoft Graph (Outlook agenda / mails) — phase 2
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=

# Protège le déclenchement automatique de l'Agent REFIT (à copier aussi dans Vercel)
CRON_SECRET=

# Jeton de l'adresse d'abonnement Outlook au planning (à garder privé)
PLANNING_ICS_TOKEN=

# Envoi d'e-mails (confirmation de demande de devis) — SMTP, fournisseur interchangeable
# Gmail : SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_USER=adresse Gmail, SMTP_PASSWORD=mot de passe d'application
# Microsoft 365 : SMTP_HOST=smtp.office365.com, SMTP_PORT=587
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
# Expéditeur affiché, ex. « REFIT Surface <adresse@gmail.com> » (même adresse que SMTP_USER avec Gmail)
MAIL_FROM=
# Adresse de réponse (facultatif)
MAIL_REPLY_TO=

# Données en direct (météo MET Norway, adresses et itinéraires IGN, secours OpenStreetMap) — aucune clé requise
# Contact transmis dans l'en-tête User-Agent, exigé par MET Norway et OpenStreetMap (e-mail ou site du gérant)
LIVE_DATA_CONTACT=
# Secours des itinéraires (openrouteservice) — clé gratuite, à ajouter une fois créée
ORS_API_KEY=
