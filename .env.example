# Supabase (Project Settings → API Keys)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Claude (console.anthropic.com → API Keys, format sk-ant-api03-…)
ANTHROPIC_API_KEY=

# Microsoft Graph (Outlook agenda / mails) — phase 2
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=

# Protège le déclenchement automatique de l'Agent REFIT (à copier aussi dans Vercel)
CRON_SECRET=

# Jeton de l'adresse d'abonnement Outlook au planning (à garder privé)
PLANNING_ICS_TOKEN=

# Envoi d'e-mails (confirmation de demande de devis) — Resend (https://resend.com)
# Clé API « re_… » (serveur uniquement, ne jamais la préfixer par NEXT_PUBLIC_)
RESEND_API_KEY=
# Expéditeur affiché, sur un domaine vérifié dans Resend, ex. « REFIT Surface <devis@refitsurface.fr> »
MAIL_FROM=
# Adresse de réponse (facultatif), ex. la boîte Microsoft 365 du gérant
MAIL_REPLY_TO=

# Données en direct (météo MET Norway, adresses et itinéraires IGN, secours OpenStreetMap) — aucune clé requise
# Contact transmis dans l'en-tête User-Agent, exigé par MET Norway et OpenStreetMap (e-mail ou site du gérant)
LIVE_DATA_CONTACT=
# Secours des itinéraires (openrouteservice) — clé gratuite, à ajouter une fois créée
ORS_API_KEY=
